#!/usr/bin/env python3
"""Run zjm in its hardened container, preserving host paths as single arguments."""
import json
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path


def option(args, name, default=None):
    """Read the last exact option, stopping at the positional-only separator."""
    value = default
    for i, arg in enumerate(args):
        if arg == "--":
            break
        if arg == name:
            if i + 1 == len(args):
                raise ValueError(f"{name} needs a value")
            value = args[i + 1]
        elif arg.startswith(name + "="):
            value = arg.split("=", 1)[1]
    return value


def replace_option(args, name, value):
    out, i = [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            out.extend(args[i:])
            break
        if arg == name:
            out.extend([name, value])
            i += 2
        elif arg.startswith(name + "="):
            out.append(name + "=" + value)
            i += 1
        else:
            out.append(arg)
            i += 1
    return out


def mount(path, target):
    path = Path(path).expanduser().resolve()
    if ":" in str(path):
        raise ValueError("mount paths cannot contain a colon")
    return ["-v", f"{path}:{target}:ro"]


def stage(source, directory, name):
    # The directory is private on the host; only the file is mounted into the container.
    # A readable file mode lets container UID 10001 read without changing the host original.
    target = Path(directory) / name
    target.write_bytes(Path(source).expanduser().read_bytes())
    target.chmod(0o444)
    return target


def main(args, directory):
    config = option(args, "--config", os.environ.get("ZJM_HOST_CONFIG"))
    if not config:
        config = str(Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "zjm/config.json")
    config = Path(config).expanduser().resolve()
    if not config.is_file():
        raise ValueError(f"host config not found: {config}; run install.sh to create the default config")
    raw = json.loads(config.read_text())
    egress = raw.get("egress", {})
    online = any(egress.get(key) is True for key in ("rank", "answer", "translate"))
    args = replace_option(args, "--config", "/etc/zjm/config.json")
    command = ["docker", "run", "--rm", "-i", "--user", "10001:10001", "--read-only",
               "--tmpfs", "/tmp:rw,size=1g,mode=1777", "--cap-drop=ALL",
               "--security-opt=no-new-privileges", "--memory=2g", "--memory-swap=2g",
               "--ulimit", "core=0", "--pids-limit=256", "-v", "zjm-data:/data"]
    command += mount(stage(config, directory, "config.json"), "/etc/zjm/config.json")
    seen = set()
    for source in filter(None, os.environ.get("ZJM_SOURCES", "").split(":")):
        path = Path(source).expanduser().resolve()
        if not path.is_dir():
            raise ValueError(f"source directory not found: {source}")
        if not path.name or path.name in seen:
            raise ValueError(f"duplicate or empty source basename: {path.name}")
        seen.add(path.name)
        command += mount(path, f"/sources/{path.name}")
    key = option(args, "--key-file")
    if key and key != "-":
        if not Path(key).expanduser().is_file():
            raise ValueError(f"key file not found: {key}")
        command += mount(stage(key, directory, "key"), "/run/zjm-key")
        args = replace_option(args, "--key-file", "/run/zjm-key")
    command += ["-e", "OPENROUTER_API_KEY"] if online else ["--network", "none"]
    if online and os.environ.get("JEV_MODEL"):
        command += ["-e", "JEV_MODEL"]
    if args and args[0] == "serve":
        if not online:
            raise ValueError("HTTP needs egress on, or use MCP")
        if option(args, "--host", "0.0.0.0") != "0.0.0.0":
            raise ValueError("serve --host must be 0.0.0.0 inside Docker; the published port is loopback-only")
        port = int(option(args, "--port", "8765"))
        host_port = int(os.environ.get("ZJM_PORT", str(port)))
        if not 1 <= port <= 65535 or not 1 <= host_port <= 65535:
            raise ValueError("port must be between 1 and 65535")
        command += ["-p", f"127.0.0.1:{host_port}:{port}"]
        args = ["serve", "--host", "0.0.0.0", "--port", str(port), *args[1:]]
    command += [os.environ.get("ZJM_IMAGE", "zjm-rag:latest"), *args]
    if os.environ.get("ZJM_LAUNCH_DRY_RUN") == "1":
        print("+ " + shlex.join(command))
    else:
        return subprocess.run(command, check=False).returncode
    return 0


if __name__ == "__main__":
    try:
        with tempfile.TemporaryDirectory(prefix="zjm-launch-") as directory:
            sys.exit(main(sys.argv[1:], directory))
    except (OSError, ValueError, AttributeError) as exc:
        print(f"zjm: {exc}", file=sys.stderr)
        sys.exit(1)
