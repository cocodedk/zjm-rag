#!/usr/bin/env bash
# Index folders into a zjm-rag locker from redacted copies, and search it.
#   zjm-project reindex LOCKER DIR...            (re)build LOCKER from DIRs; run after every change to them
#   zjm-project find LOCKER "QUERY" [ZJM-ARGS]   e.g. --limit 30 --min-score 0.3 --no-rank
#   zjm-project ask LOCKER "QUESTION" [ZJM-ARGS] an answer from the accepted files, with citations
# ZJM_MULTILINGUAL=1 on reindex builds the locker for non-English text; ZJM_EXCLUDE="*.pdf,drafts/" leaves out
# files and folders (trailing /) by name; ZJM_LOCAL=1 keeps a search on this machine (no ranking, no ask).
# Each DIR mounts read-only as /sources/<its folder name>, so names must differ. ZJM_FORCE=1 replaces a locker built from other folders.
set -euo pipefail
CMD=${1:-} LOCKER=${2:-}; shift 2 || { sed -n 2,6p "$0" >&2; exit 2; }
HERE=$(cd "$(dirname "$0")" && pwd)
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/zjm-project/$LOCKER"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
config() {  # $1: the allow list; ZJM_EXCLUDE: comma-separated name globs; ZJM_LOCAL=1: nothing leaves the machine
  local out=true ex=""; [ -n "${ZJM_LOCAL:-}" ] && out=false
  local pats=(); [ -n "${ZJM_EXCLUDE:-}" ] && IFS=, read -ra pats <<< "$ZJM_EXCLUDE" && ex=$(printf '"%s",' "${pats[@]}") && ex=${ex%,}
  printf '{"home": "/data", "allow": [%s], "exclude": [%s], "egress": {"rank": %s, "answer": %s}}\n' "$1" "$ex" $out $out > "$TMP/config.json"
  export ZJM_HOST_CONFIG="$TMP/config.json"; }
case $CMD in
  reindex)
    srcs=() allow=() names=()
    for d in "$@"; do
      d=$(realpath "$d"); n=$(basename "$d")
      [[ " ${names[*]} " == *" $n "* ]] && { echo "two folders named $n: rename one or index it separately" >&2; exit 2; }
      python3 "$HERE/mirror.py" "$d" "$TMP/$n"
      names+=("$n"); srcs+=("$TMP/$n"); allow+=("\"/sources/$n\"")
    done
    config "$(IFS=,; echo "${allow[*]}")"; export ZJM_SOURCES; ZJM_SOURCES=$(IFS=:; echo "${srcs[*]}")
    want=$(for d in "$@"; do realpath "$d"; done)
    if zjm locker-list | awk -v l="$LOCKER" '$1 == l {f=1} END {exit !f}'; then
      [ "$(cat "$STATE/dirs" 2>/dev/null)" = "$want" ] || [ -n "${ZJM_FORCE:-}" ] || {
        echo "locker $LOCKER exists and was not built from these folders; pick another name, or ZJM_FORCE=1 to replace it" >&2; exit 2; }
      zjm locker-drop "$LOCKER" >/dev/null; rm -f "$STATE/dirs"
    fi
    zjm locker-create "$LOCKER" --plain ${ZJM_MULTILINGUAL:+--multilingual} >/dev/null
    zjm file-add "$LOCKER" "${names[@]/#//sources/}" | tail -1
    mkdir -p "$STATE"; echo "$want" > "$STATE/dirs"; touch "$STATE/stamp"
    zjm locker-list | awk -v l="$LOCKER" '$1 == l' ;;
  find|ask)
    [ -f "$STATE/dirs" ] || { echo "no locker $LOCKER from this script: reindex first" >&2; exit 2; }
    while read -r d; do  # warn, never block: a stale locker misses new text and still shows removed text
      [ -n "$(find "$d" -newer "$STATE/stamp" -not -path '*/.git/*' -print -quit 2>/dev/null)" ] \
        && echo "STALE: $d changed since the last reindex; run reindex before trusting this search" >&2
    done < "$STATE/dirs"
    config ""; zjm "$CMD" "$1" -l "$LOCKER" "${@:2}" ;;
  *) sed -n 2,6p "$0" >&2; exit 2 ;;
esac
